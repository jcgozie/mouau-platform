# Copy to .env.local for local dev, or set these in your hosting
# platform's environment variables (e.g. Vercel Project Settings).

# Required by NextAuth for JWT signing. Generate your own for any real
# deployment: `openssl rand -base64 32` — never reuse the dev value.
NEXTAUTH_SECRET=

# Your deployed URL in production (Vercel sets this automatically via
# VERCEL_URL in most cases, but setting it explicitly is safer).
NEXTAUTH_URL=http://localhost:3000

# Stage 1 CMS integration point — leave unset to use mock content.
CMS_API_URL=
